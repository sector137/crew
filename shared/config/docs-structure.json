  "access_control": {
    "rules": {
      "read": "All agents can read all /docs/* directories",
      "write": "Each agent can ONLY write to their designated domain(s)",
      "create": "Agents must NOT create additional top-level /docs/* directories"
    },
    "matrix": [
      { "agent": "ai-oracle",       "character": "Oracle",          "read": ["/docs/*"], "write": ["/docs/ai/*"] },
      { "agent": "design-wren",     "character": "Wren Glasswork",  "read": ["/docs/*"], "write": ["/docs/ux/*"] },
      { "agent": "product-margot",  "character": "Margot Flux",     "read": ["/docs/*"], "write": ["/docs/product/*"] },
      { "agent": "engineering-kael","character": "Kael Deepstack",  "read": ["/docs/*"], "write": ["/docs/engineering/*"] },
      { "agent": "quality-judge",   "character": "Judge Veridia",   "read": ["/docs/*"], "write": ["/docs/testing/*"] },
      { "agent": "security-cipher", "character": "Cipher Locke",    "read": ["/docs/*"], "write": ["/docs/security/*"] },
      { "agent": "intel-vesper",    "character": "Vesper Null",     "read": ["/docs/*"], "write": ["/docs/market-research/*"] },
      { "agent": "gtm-nova",        "character": "Nova Amplitude",  "read": ["/docs/*"], "write": ["/docs/gtm/*"] },
      { "agent": "sales-harlan",    "character": "Harlan Closer",   "read": ["/docs/*"], "write": ["/docs/sales/*"] },
      { "agent": "overseer-nyx",    "character": "Nyx Panoptica",   "read": ["/docs/*"], "write": ["/docs/executive/*"] },
      { "agent": "sre-atlas",       "character": "Atlas Vance",     "read": ["/docs/*"], "write": ["/docs/reliability/*"] },
      { "agent": "sal",             "character": "Software Sal",    "read": ["/docs/*"], "write": ["/docs/project/*", "/docs/workflows/*"] }
    ]
  },
  "conventions": {
    "file_naming": {
      "living_documents": "Fixed names (e.g., personas.md, ai-knowledge.md)",
      "dated_reports": "{type}-{topic}-{YYYY-MM-DD}.md",
      "templates": "{name}-template.md",
      "adrs": "adr-{number}-{decision}.md"
    },
    "required_sections": {
      "tldr": "3-5 critical bullet points at top of every document",
      "action_plan": "Specific, prioritized next steps near end of document (FINDINGS for executive)",
      "metadata": "Date, context, dependencies, links at document top",
      "cross_references": "Links to related documents across domains",
      "traceability": "Decisions linked back to requirements/research"
    },
    "directory_pattern": {
      "description": "Standard subdirectory pattern for each domain",
      "structure": [
        "/{primary-outputs}/",
        "/templates/",
        "/reference/",
        "README.md"
      ]
    }
  },
  "workflows": {
    "phases": [
      "Discovery",
      "Definition",
      "Design",
      "Development",
      "Testing",
      "Deployment",
      "Operations"
    ],
    "quality_gates": [
      "Discovery → Definition",
      "Definition → Design",
      "Design → Development",
      "Development → Testing",
      "Testing → Deployment",
      "Deployment → Production",
      "Production → Iteration"
    ]
  }
}
