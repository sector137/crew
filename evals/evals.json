{
  "name": "sector137-crew-evals",
  "description": "Skill-creator-format behavioural evals for the Sal's Crew pipeline skills. Text assertions only (contains/containsKeyword/regex), so this file stays valid for skill-creator runs inside Claude Code — the ground truth. Tool-call, dual-mode, and offline-fallback cases live in evals.runner.json and run through the OpenRouter runner (evals/runner). MCP-dependent side effects are exercised there against mocked tools; run the real thing against a connected instance.",
  "testCases": [
    {
      "id": "add-infers-metadata",
      "skill": "add",
      "prompt": "add a dark mode toggle to the backlog — high priority, it's a UX thing",
      "assertions": [
        { "type": "containsKeyword", "keyword": "dark mode" },
        { "type": "containsKeyword", "keyword": "high" },
        { "type": "contains", "text": "feature" }
      ]
    },
    {
      "id": "plan-produces-structure",
      "skill": "plan",
      "prompt": "plan how to add rate limiting to the login endpoint",
      "assertions": [
        { "type": "contains", "text": "Files" },
        { "type": "contains", "text": "Steps" },
        { "type": "contains", "text": "Risks" },
        { "type": "contains", "text": "/sector137:build" }
      ]
    },
    {
      "id": "build-never-marks-done",
      "skill": "build",
      "prompt": "build the rate limiting issue #42",
      "assertions": [
        { "type": "containsKeyword", "keyword": "test" },
        { "type": "contains", "text": "/sector137:issues" },
        { "type": "regex", "pattern": "(?i)don.t mark|never.{0,15}(done|complete)|human" }
      ]
    },
    {
      "id": "build-gates-behind-flag",
      "skill": "build",
      "prompt": "build the new CSV export feature",
      "assertions": [
        { "type": "containsKeyword", "keyword": "flag" },
        { "type": "contains", "text": "feature-flags" }
      ]
    },
    {
      "id": "ship-enforces-strict-gate",
      "skill": "ship",
      "prompt": "ship the release",
      "assertions": [
        { "type": "regex", "pattern": "(?i)confirm" },
        { "type": "containsKeyword", "keyword": "test" },
        { "type": "regex", "pattern": "(?i)completed|cancelled|blocked" }
      ]
    },
    {
      "id": "ship-picks-a-bump",
      "skill": "ship",
      "prompt": "ship the release",
      "assertions": [
        { "type": "regex", "pattern": "(?i)major|minor|patch|bump" }
      ]
    },
    {
      "id": "whats-next-returns-five",
      "skill": "whats-next",
      "prompt": "what should I work on next?",
      "assertions": [
        { "type": "regex", "pattern": "(?s)5.{0,40}(action|thing|next)|(^|\\n)\\s*5[.)]" }
      ]
    },
    {
      "id": "review-fixes-not-just-reports",
      "skill": "review",
      "prompt": "review my recent changes for performance",
      "assertions": [
        { "type": "regex", "pattern": "(?i)react|typescript" },
        { "type": "regex", "pattern": "(?i)fix" }
      ]
    },
    {
      "id": "prioritize-shows-new-kanban",
      "skill": "prioritize",
      "prompt": "show me the roadmap",
      "assertions": [
        { "type": "regex", "pattern": "(?i)backlog" },
        { "type": "regex", "pattern": "(?i)in.progress|planned" }
      ]
    },
    {
      "id": "init-offers-local-mode",
      "skill": "init",
      "prompt": "set up a roadmap for this project",
      "assertions": [
        { "type": "contains", "text": ".sector137/roadmap.md" },
        { "type": "regex", "pattern": "(?i)local|offline|sync" }
      ]
    },
    {
      "id": "continue-summarizes-state",
      "skill": "continue",
      "prompt": "where was I?",
      "assertions": [
        { "type": "regex", "pattern": "(?i)branch" },
        { "type": "regex", "pattern": "(?i)commit|recent|active" },
        { "type": "regex", "pattern": "(?i)what.{0,20}(work|next)" }
      ]
    },
    {
      "id": "issues-close-is-test-gated",
      "skill": "issues",
      "prompt": "mark issue #42 done",
      "assertions": [
        { "type": "regex", "pattern": "(?i)test" },
        { "type": "regex", "pattern": "(?i)completed|done" }
      ]
    },
    {
      "id": "update-detects-install-mode",
      "skill": "update",
      "prompt": "update the plugin",
      "assertions": [
        { "type": "regex", "pattern": "(?i)marketplace|git|dev" },
        { "type": "regex", "pattern": "(?i)changelog|version" }
      ]
    },
    {
      "id": "version-check-gates",
      "skill": "version",
      "prompt": "check the version",
      "assertions": [
        { "type": "regex", "pattern": "(?i)version" },
        { "type": "regex", "pattern": "(?i)plugin.json|marketplace|manifest|match" }
      ]
    },
    {
      "id": "handoff-emits-next-prompt",
      "skill": "handoff",
      "prompt": "wrap up this session",
      "assertions": [
        { "type": "regex", "pattern": "(?i)summary|shipped|session" },
        { "type": "regex", "pattern": "(?i)next session|next-session|prompt|pick.?up" }
      ]
    },
    {
      "id": "wren-review-stays-operational",
      "skill": "wren",
      "prompt": "review the checkout flow UX before we ship",
      "assertions": [
        { "type": "containsKeyword", "keyword": "design-principles" },
        { "type": "regex", "pattern": "(?i)critical|high|severity" },
        { "type": "contains", "text": "/docs/ux/" }
      ]
    },
    {
      "id": "kael-adr-has-structure",
      "skill": "kael",
      "prompt": "write an ADR for choosing Postgres over MongoDB for the events store",
      "assertions": [
        { "type": "regex", "pattern": "(?i)context" },
        { "type": "regex", "pattern": "(?i)consequences|alternatives" },
        { "type": "contains", "text": "/docs/engineering/adrs/" }
      ]
    },
    {
      "id": "margot-prd-keeps-doc-standard",
      "skill": "margot",
      "prompt": "create a PRD for team workspaces",
      "assertions": [
        { "type": "contains", "text": "TLDR" },
        { "type": "contains", "text": "ACTION PLAN" },
        { "type": "contains", "text": "/docs/product" }
      ]
    },
    {
      "id": "harlan-pitch-has-structure",
      "skill": "harlan",
      "prompt": "help me prep a pitch for an enterprise demo tomorrow",
      "assertions": [
        { "type": "regex", "pattern": "(?i)objection|value|pain|discovery" },
        { "type": "regex", "pattern": "(?i)pitch|demo|close|deal" }
      ]
    },
    {
      "id": "mira-retro-measures",
      "skill": "mira",
      "prompt": "run a crew retrospective for this sprint",
      "assertions": [
        { "type": "regex", "pattern": "(?i)retro|pattern|telemetry|langfuse" },
        { "type": "regex", "pattern": "(?i)improve|coach|action" }
      ]
    },
    {
      "id": "sal-routes-prd-into-pipeline",
      "skill": "sal",
      "prompt": "I have a signed-off PRD for team workspaces — get it into the pipeline",
      "assertions": [
        { "type": "containsKeyword", "keyword": "issue" },
        { "type": "contains", "text": "/sector137:plan" },
        { "type": "contains", "text": "/sector137:build" }
      ]
    }
  ]
}
